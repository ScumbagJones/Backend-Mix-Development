# Spotify API (for playlist reading)
SPOTIFY_CLIENT_ID=your_client_id_here
SPOTIFY_CLIENT_SECRET=your_client_secret_here

# AzuraCast
AZURACAST_BASE_URL=http://your-azuracast-instance.com
AZURACAST_API_KEY=your_api_key_here
AZURACAST_STATION_ID=1

# MusicBrainz (no key needed, just identification)
MUSICBRAINZ_APP_NAME=PlaylistConverter
MUSICBRAINZ_APP_VERSION=1.0.0
MUSICBRAINZ_CONTACT=your_email@example.com

# AcoustID (optional, for audio fingerprinting)
ACOUSTID_API_KEY=your_acoustid_key_here

# Download settings
DOWNLOAD_DIR=./downloads
AUDIO_FORMAT=mp3
AUDIO_QUALITY=320
